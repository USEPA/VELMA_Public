        li.version-dropdown
            select#version-dropdown.select-bubble.blue-dark.white-text(name="version-dropdown" data-current-path=currentPath)
                option(value="2.2") 2.2 (current)
                option(value="2.1") 2.1
                option(value="2.0") 2.0 
                option(value="dev") dev
                
script. 
    function getVersionFromUrl() {
        const url = window.location.pathname; // Get the current URL path
        const match = url.match(/\/version\/([^/]+)\//); // Regex to extract version after '/version/'
        return match ? match[1] : null; // Return the version or null if not found
    }

    function setSelectedVersion() {
        const versionDropdown = document.getElementById('version-dropdown');
        const currentVersion = getVersionFromUrl(); // Get current version from URL
        if (currentVersion) {
            const options = versionDropdown.options;
            for (let i = 0; i < options.length; i++) {
                if (options[i].value === currentVersion) {
                    options[i].selected = true; // Set the matching option as selected
                    break;
                }
            }
        }
    }
    
    document.getElementById('version-dropdown').addEventListener('change', function(event) {
        const selectedVersion = event.target.value;
        console.log(selectedVersion);
        const currentPath = event.target.getAttribute('data-current-path');
        const newPath = currentPath.replace(/\/version\/\d+\.\d+\//, `/version/${selectedVersion}/`);
        console.log(newPath);
        window.location.href = newPath;
    });

    //- Call setSelectedVersion on page load
    document.addEventListener('DOMContentLoaded', setSelectedVersion);